# All optional — sane defaults point at the production relay + Blossom server.
# Nothing here is a secret: this server is read-only, it never signs or publishes.

# Comma-separated relay URLs to query for the catalog (kind 31337 tracks,
# kind 30311 live activity) and artist profiles (kind 0). Only put a relay
# here if it gates writes the same way relay.lightning.fm does (allowlisted
# artists only) — an unrestricted public relay hands back every other app's
# kind-31337 events too, not just Lightning FM's.
LFM_NOSTR_RELAYS=wss://relay.lightning.fm

# Blossom server tracks resolve audio/image hashes against when a track
# only carries an x-tag (content hash) and no direct url.
LFM_BLOSSOM_URL=https://media.lightning.fm

# How long fetched catalog/profile/now-playing data is cached in-process
# before the next tool call triggers a fresh relay fetch, in milliseconds.
LFM_CACHE_TTL_MS=60000
